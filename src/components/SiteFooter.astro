---
// Site-wide footer. The "full" variant carries the oversized initials, year and
// contact links; "minimal" keeps only the legal bar, for pages that already say
// "Let's talk" in their own content.
interface Props {
  variant?: 'full' | 'minimal';
}

const { variant = 'full' } = Astro.props;
---

<footer class:list={['site-footer', 'container', variant]}>
  {variant === 'full' && (
  <>
  <div class="divider"></div>
  <div class="grid content">
    <p class="mark t-h1" data-reveal>AA</p>
    <div class="talk" data-reveal>
      <p class="t-h1">Let&rsquo;s talk</p>
      <ul class="links t-subtitle">
        <li><a href="mailto:abrosovsasha@gmail.com">abrosovsasha@gmail.com</a></li>
        <li><a href="https://www.linkedin.com/in/oleksandr-abrosov/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://www.instagram.com/abrosov/" target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>
    <p class="year t-h1" data-reveal>&lsquo;26</p>
  </div>
  </>
  )}
  <div class="legal t-button" data-reveal={variant === 'full' ? true : undefined}>
    <p>&copy; 2026</p>
    <p>Barcelona, Spain</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
  }

  .divider {
    height: 1px;
    background: var(--color-ink);
  }

  .content {
    align-items: start;
  }

  .mark,
  .year {
    font-size: 234px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .mark {
    grid-column: 1 / 5;
  }

  .talk {
    grid-column: 5 / 10;
    padding-top: 29px;
  }

  .year {
    grid-column: 10 / 13;
    justify-self: end;
  }

  .links {
    margin-top: 24px;
    list-style: none;
  }

  .links a {
    text-decoration: underline;
    text-underline-position: from-font;
  }

  @media (max-width: 1180px) {
    /* The sign-off leads, with the initials and year sitting beneath it */
    .talk {
      grid-column: 1 / -1;
      grid-row: 1;
      padding-top: 48px;
    }

    .mark {
      grid-column: 1 / 4;
      grid-row: 2;
    }

    .year {
      grid-column: 4 / -1;
      grid-row: 2;
    }

    .mark,
    .year {
      margin-top: 48px;
      font-size: 160px;
    }
  }

  @media (max-width: 767px) {
    .mark,
    .year {
      font-size: 96px;
    }

    .talk {
      padding-top: 32px;
    }

    .talk .t-h1 {
      font-size: 56px;
      line-height: 52px;
    }

    .legal {
      margin-top: 32px;
    }
  }

  .legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 48px;
    border-top: 1px solid var(--color-ink);
    margin-top: 49px;
  }

  .minimal .legal {
    border-top-color: var(--color-rule-soft);
    margin-top: 0;
  }
</style>
