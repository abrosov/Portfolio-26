---
// One "Solution Details" panel: a labelled feature with a full-width mockup.
// Panels stack inside .feature-stack, each pinning as the next slides over it.
import GridLines from './GridLines.astro';

interface Props {
  index: number;
  title: string;
  body: string;
  image: string;
  alt: string;
  /* Placement of the mockup inside its tile, as % of the tile */
  frame: { left: string; top: string; width: string };
}

const { index, title, body, image, alt, frame } = Astro.props;
---

<section class="case-feature container case-grid">
  <GridLines local />
  <p class="case-label col-label t-subtitle" data-reveal>/ Feature {index}</p>
  <div class="col-text" data-reveal>
    <h2 class="t-subtitle">{title}</h2>
    <p class="case-feature-body t-body">{body}</p>
  </div>
  <div class="case-tile" data-reveal>
    <img src={image} alt={alt} style={`left:${frame.left};top:${frame.top};width:${frame.width}`} />
  </div>
</section>
