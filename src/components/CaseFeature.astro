---
// One "Solution Details" panel: a labelled feature with a full-width mockup.
// Panels stack inside .feature-stack, each pinning as the next slides over it.
import GridLines from './GridLines.astro';
import Pic from './Pic.astro';

interface Props {
  index: number;
  title: string;
  body: string;
  image: string;
  alt: string;
  /* Placement of the mockup inside its tile, as % of the tile. Omit it when
     the image is the finished tile, background and all, and it fills. */
  frame?: { left: string; top: string; width: string };
}

const { index, title, body, image, alt, frame } = Astro.props;
---

<section class="case-feature container case-grid">
  <GridLines local />
  <p class="case-label col-label t-subtitle" data-reveal>/ Feature {index}</p>
  <div class="col-text" data-reveal>
    <h2 class="t-subtitle" data-label={`Feature ${index}`}>{title}</h2>
    <p class="case-feature-body t-body">{body}</p>
  </div>
  <div class="case-tile" data-reveal>
    <Pic
      src={image}
      alt={alt}
      class={frame ? undefined : 'is-plate'}
      style={frame ? `left:${frame.left};top:${frame.top};width:${frame.width}` : undefined}
    />
  </div>
</section>

<style>
  /* A tile exported whole: the image already carries the accent behind the
     mockup, so it covers the tile instead of being placed on it. */
  .case-tile :global(.is-plate) {
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
