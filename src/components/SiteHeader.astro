---
// Site-wide header: nav links left, name centered, resume + contact right.
---

<header class="site-header container">
  <nav class="left">
    <a class="t-button" href="/#cases">Cases</a>
  </nav>
  <a class="name t-subtitle" href="/">Alex Abrosov</a>
  <nav class="right">
    <a class="t-button" href="/resume.pdf" target="_blank">Resume</a>
    <a class="contact t-button" href="/contact/">Contact</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    /* Opaque so content scrolls underneath rather than through. */
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
  }

  .left,
  .right {
    display: flex;
    align-items: center;
    gap: 45px;
  }

  .right {
    gap: 28px;
  }

  .name {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .contact {
    background: var(--color-ink);
    color: var(--color-button-label);
    padding: 8px 16px;
    border-radius: 4px;
  }

  /* Nav links underline on hover. Fading the decoration colour rather than
     toggling the rule keeps the text from shifting. */
  .left a,
  .right a:not(.contact) {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }

  .left a:hover,
  .right a:not(.contact):hover,
  .left a:focus-visible,
  .right a:not(.contact):focus-visible {
    text-decoration-color: currentColor;
  }

  /* The Contact pill behaves like the form's submit button, not a text link. */
  .contact {
    transition: opacity 0.2s ease;
  }

  .contact:hover,
  .contact:focus-visible {
    opacity: 0.85;
  }
</style>
