---
import BaseLayout from '../layouts/BaseLayout.astro';

// Formspree form ID — the last segment of https://formspree.io/f/<id>
const FORMSPREE_ID = 'xbgjlkro';
const endpoint = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : '';
---

<BaseLayout title="Let’s talk — Alex Abrosov" footer="minimal" palette="contact">
  <section class="contact container grid">
    <div class="intro">
      <h1 class="t-h1" data-reveal>Let&rsquo;s talk</h1>
      <p class="t-body-2" data-reveal>
        Thanks for your interest! Fill out the form below and I&rsquo;ll get back to you within one
        business day.
      </p>
      <ul class="links t-subtitle" data-reveal>
        <li><span aria-hidden="true">/</span><a href="mailto:abrosovsasha@gmail.com">abrosovsasha@gmail.com</a></li>
        <li>
          <span aria-hidden="true">/</span>
          <a href="https://www.linkedin.com/in/bohdshchk/" target="_blank" rel="noopener">LinkedIn</a>
        </li>
        <li>
          <span aria-hidden="true">/</span>
          <a href="https://www.instagram.com/abrosov/" target="_blank" rel="noopener">Instagram</a>
        </li>
      </ul>
    </div>

    <form class="form" method="POST" action={endpoint}>
      <div class="field" data-reveal>
        <label class="t-button" for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Name"
          autocomplete="name"
          maxlength="80"
          required
          aria-describedby="name-error"
        />
        <p class="field-error t-button" id="name-error"></p>
      </div>
      <div class="field" data-reveal>
        <label class="t-button" for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="Email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="email-error"
        />
        <p class="field-error t-button" id="email-error"></p>
      </div>
      <div class="field" data-reveal>
        <label class="t-button" for="note">Note (optional)</label>
        <textarea
          id="note"
          name="note"
          placeholder="Note"
          rows="3"
          maxlength="1000"
          aria-describedby="note-error note-count"></textarea>
        <p class="field-foot">
          <span class="field-error t-button" id="note-error"></span>
          <span class="field-count t-button" id="note-count" aria-live="polite"></span>
        </p>
      </div>
      <input class="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="actions" data-reveal>
        <button class="submit t-button" type="submit">Send Message</button>
      </div>
      <p class="form-status t-body" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<script>
  // Validation and submission. Both are progressive: the markup alone still
  // posts to the endpoint and still uses the browser's own required/type
  // checks, so this only takes over once the script runs.
  const form = document.querySelector<HTMLFormElement>('.form');
  const status = document.querySelector<HTMLParagraphElement>('.form-status');
  const note = document.querySelector<HTMLTextAreaElement>('#note');
  const noteCount = document.querySelector<HTMLElement>('#note-count');

  const NOTE_MAX = 1000;

  // Deliberately permissive: catching real typos, not policing valid addresses.
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  type Check = (value: string) => string | null;

  const checks: Record<string, Check> = {
    name: (v) => {
      if (!v) return 'Please add your name.';
      if (v.length < 2) return 'Please use at least two characters.';
      return null;
    },
    email: (v) => {
      if (!v) return 'Please add your email.';
      if (!EMAIL.test(v)) return 'That doesn’t look like an email address.';
      return null;
    },
    note: (v) => (v.length > NOTE_MAX ? `Please keep the note under ${NOTE_MAX} characters.` : null),
  };

  const fieldOf = (el: HTMLElement) => el.closest<HTMLElement>('.field');

  function show(el: HTMLInputElement | HTMLTextAreaElement, message: string | null) {
    const field = fieldOf(el);
    const error = document.querySelector<HTMLElement>(`#${el.id}-error`);
    if (!field || !error) return;

    field.classList.toggle('is-invalid', Boolean(message));
    // A quiet confirmation, only once there is something to confirm.
    field.classList.toggle('is-valid', !message && el.value.trim().length > 0);
    el.setAttribute('aria-invalid', message ? 'true' : 'false');
    error.textContent = message ?? '';
  }

  function validate(el: HTMLInputElement | HTMLTextAreaElement) {
    const check = checks[el.name];
    if (!check) return true;
    const message = check(el.value.trim());
    show(el, message);
    return !message;
  }

  function fields() {
    return [...form!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].filter(
      (el) => el.name in checks
    );
  }

  function updateCount() {
    if (!note || !noteCount) return;
    const left = NOTE_MAX - note.value.length;
    // Silent until the limit is close enough to matter.
    noteCount.textContent = left <= 100 ? `${left} characters left` : '';
    noteCount.classList.toggle('is-low', left <= 20);
  }

  if (form) {
    // Our messages replace the browser's bubbles — but only now that we can
    // render them. Without this script the native checks still apply.
    form.noValidate = true;

    for (const el of fields()) {
      el.addEventListener('blur', () => validate(el));
      el.addEventListener('input', () => {
        // Re-check while typing only after a field has already been flagged,
        // so nobody is told they are wrong halfway through their first word.
        if (fieldOf(el)?.classList.contains('is-invalid')) validate(el);
        if (el === note) updateCount();
      });
    }
    updateCount();
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const all = fields();
    const bad = all.filter((el) => !validate(el));
    if (bad.length) {
      status.textContent = 'Please check the highlighted fields.';
      status.className = 'form-status t-body is-error';
      bad[0].focus();
      return;
    }

    // Read the attribute, not form.action — the latter resolves an empty
    // action to the current page URL, which would post the form to itself.
    const endpoint = form.getAttribute('action');
    if (!endpoint) {
      status.textContent = 'The form is not connected yet — email me directly for now.';
      status.className = 'form-status t-body is-error';
      return;
    }

    const button = form.querySelector('button');
    form.classList.add('is-sending');
    button?.setAttribute('disabled', '');
    for (const el of all) el.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'form-status t-body';

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      for (const el of all) {
        fieldOf(el)?.classList.remove('is-valid', 'is-invalid');
        el.removeAttribute('aria-invalid');
      }
      updateCount();
      status.textContent = 'Thanks — I’ll get back to you within one business day.';
      status.className = 'form-status t-body is-ok';
    } catch {
      status.textContent = 'Something went wrong. Please email me at abrosovsasha@gmail.com.';
      status.className = 'form-status t-body is-error';
    } finally {
      form.classList.remove('is-sending');
      button?.removeAttribute('disabled');
      for (const el of all) el.disabled = false;
    }
  });
</script>

<style>
  .contact {
    align-items: start;
    padding-top: 80px;
    padding-bottom: 96px;
  }

  .intro {
    grid-column: 2 / 6;
  }

  .intro .t-body-2 {
    margin-top: 32px;
  }

  .links {
    /* Puts the first link at y=394, per the design. */
    margin-top: 56px;
    list-style: none;
  }

  .links a {
    text-decoration: underline;
    text-underline-position: from-font;
  }

  /* Set in CSS, not as source whitespace, which the compiler strips when the
     link sits on its own line. */
  .links span {
    margin-right: 0.25em;
  }

  /* ---- Intro ----
     The first screen rises further and slower than a scroll reveal, each block
     following the one above it. Matches the reference contact page. */
  .contact [data-reveal] {
    --reveal-shift: var(--intro-shift);
    --reveal-duration: var(--intro-duration);
    --reveal-ease: var(--intro-ease);
  }

  .intro .t-body-2 {
    --reveal-delay: var(--intro-step);
  }

  .links {
    --reveal-delay: calc(var(--intro-step) * 2);
  }

  .field:nth-of-type(1) {
    --reveal-delay: calc(var(--intro-step) * 3);
  }

  .field:nth-of-type(2) {
    --reveal-delay: calc(var(--intro-step) * 4);
  }

  .field:nth-of-type(3) {
    --reveal-delay: calc(var(--intro-step) * 5);
  }

  .actions {
    --reveal-delay: calc(var(--intro-step) * 6);
  }

  /* ---- Form ---- */

  .form {
    grid-column: 7 / 11;
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 68px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* A resting field is its fill alone, as the mock draws it. The stroke is a
     ring rather than a border: the mock draws it outside the box, and a ring
     leaves the field the same size whether or not it is showing, so nothing
     shifts when one appears. */
  input,
  textarea {
    width: 100%;
    background: var(--color-field);
    border: 0;
    border-radius: 4px;
    box-shadow: none;
    padding: 0 12px;
    font: 500 16px/36px var(--font-display);
    color: var(--color-ink);
    transition: box-shadow 0.18s ease;
  }

  input {
    height: 36px;
  }

  textarea {
    height: 85px;
    padding: 6px 12px;
    line-height: 1.4;
    resize: vertical;
  }

  ::placeholder {
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
  }

  /* ---- Field states ----
     Nothing until the field is active, then the stroke. Only an error shows
     one otherwise, and it is the one thing here that is not the stroke. */

  /* :focus, not :focus-visible — a text field being active is always worth
     showing, however the person got there, including when a failed submit
     sends focus to the first field that needs fixing. */
  input:focus,
  textarea:focus {
    outline: none;
    box-shadow: 0 0 0 var(--field-line-active) var(--color-field-line-active);
  }

  /* After focus, so a field being corrected keeps saying it is wrong. */
  .field.is-invalid input,
  .field.is-invalid textarea {
    box-shadow: 0 0 0 var(--field-line-active) var(--color-danger);
  }

  .field.is-invalid label {
    color: var(--color-danger);
  }

  .field-error {
    margin-top: 8px;
    color: var(--color-danger);
  }

  .field-error:empty {
    display: none;
  }

  /* Message and counter share a row; the counter holds the right edge even
     before it has anything to say, so nothing shifts when it appears. */
  .field-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .field-count {
    margin-top: 8px;
    /* Holds the right edge whether or not a message shares the row. */
    margin-left: auto;
    color: color-mix(in srgb, var(--color-ink) 50%, transparent);
  }

  .field-count:empty {
    display: none;
  }

  .field-count.is-low {
    color: var(--color-danger);
  }

  input:disabled,
  textarea:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    input,
    textarea {
      transition: none;
    }
  }

  /* A cleared error is the confirmation; a second line saying so would only
     add noise to a form this short. */

  .actions {
    /* 32px below the fields in the design; the column gap supplies 24. */
    margin-top: 8px;
  }

  .submit {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    border: 0;
    border-radius: 4px;
    background: var(--color-ink);
    color: var(--color-button-label);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  @media (hover: hover) {
    .submit:hover {
      opacity: 0.85;
    }
  }

  .submit[disabled] {
    cursor: default;
    opacity: 0.6;
  }

  .form-status:empty {
    display: none;
  }

  .form-status.is-error {
    color: var(--color-danger);
  }

  .form-status.is-ok {
    color: var(--color-ink);
  }

  /* ---- Tablet and mobile ----
     The form drops below the intro rather than sitting beside it. */
  @media (max-width: 1180px) {
    .contact {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .intro,
    .form {
      grid-column: 1 / -1;
    }

    .form {
      margin-top: 56px;
    }

    .links {
      margin-top: 48px;
    }
  }

  @media (max-width: 767px) {
    .contact {
      padding-top: 40px;
      padding-bottom: 56px;
    }

    .intro h1 {
      font-size: 56px;
      line-height: 52px;
    }

    .intro .t-body-2 {
      margin-top: 24px;
    }

    .form {
      margin-top: 48px;
    }
  }

  /* Spam trap — hidden from people, visible to bots. */
  .gotcha {
    display: none;
  }
</style>
