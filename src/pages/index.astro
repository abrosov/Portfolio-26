---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Pic from '../components/Pic.astro';
---

<BaseLayout title="Alex Abrosov — Design Engineer">
  <!-- Hero -->
  <section class="hero container grid" id="about">
    <div class="hero-aside" data-reveal>
      <p class="t-h2">AA</p>
      <p class="t-subtitle roles">
        / Design Engineering<br />
        / Art Direction<br />
        / Product Management
      </p>
      <p class="t-subtitle location">/ Barcelona, Spain</p>
    </div>
    <div class="hero-main">
      <Pic eager class="hero-portrait" data-reveal src="/images/hero-portrait.png" alt="Portrait of Alex Abrosov" width="73" height="109" />
      <i class="pointer pointer-intro" aria-hidden="true" data-reveal></i>
      <h1 class="hero-headline t-h2" data-reveal>
        Design Engineer<br />
        with a decade of experience in Interface Design<em class="amp"> &amp; </em>Art Direction.
      </h1>
      <p class="hero-statement t-h2" data-reveal>
        I set a strong product vision that scales, builds trust, and increases <span class="crafted">
          conversion.
          <i class="pointer" aria-hidden="true"></i>
          <em class="t-h3-serif">All crafted with love.</em>
        </span>
      </p>
    </div>
  </section>

  <!-- Selected cases — featured -->
  <section class="cases-featured container" id="cases">
    <SectionTitle title="Selected Cases" />
    <div class="grid">
      <div class="feature-left" data-reveal>
        <!-- Each tile link repeats its heading's link, so it stays out of the tab
             order and the accessibility tree; the heading is what gets announced. -->
        <a class="tile tile-climate" href="/cases/climate-tech-viewer/" aria-hidden="true" tabindex="-1">
          <Pic src="/images/case-climate-tech.png" alt="Climate Tech Viewer interface" />
        </a>
      </div>
      <div class="feature-right">
        <article class="case-intro intro-wide" data-reveal>
          <p class="case-meta t-subtitle">Product Design &amp; Art Direction <i></i> &rsquo;26</p>
          <h3 class="t-h3">
            <a href="/cases/climate-tech-viewer/">Climate Tech <br /><em class="t-h3-serif">Viewer</em></a>
          </h3>
          <p class="t-body">
            A platform that helps businesses explore<br />
            and evaluate technologies for reducing greenhouse<br />
            gas emissions across fast-growing industries.
          </p>
        </article>
        <a class="tile tile-hirepeak" href="/cases/hirepeak/" aria-hidden="true" tabindex="-1" data-reveal>
          <Pic src="/images/case-hirepeak/card.jpg" alt="HirePeak documents workspace on a laptop" />
        </a>
        <article class="case-intro intro-wide" data-reveal>
          <p class="case-meta t-subtitle">Product Design &amp; Engineering <i></i> &rsquo;26</p>
          <h3 class="t-h3"><a href="/cases/hirepeak/">Hire<em class="t-h3-serif">Peak</em></a></h3>
          <p class="t-body">
            An AI-powered HRM system that analyzes and enhances candidate CVs, helping recruiters
            streamline hiring and make more informed decisions.
          </p>
        </article>
      </div>
    </div>
    <p class="expertise-label t-subtitle" data-reveal>Expertise &amp; key value</p>
    <p class="expertise-quote t-quote" data-reveal>
      Transforming complex ideas into thoughtful product experiences that solve real problems and
      drive the business forward.
    </p>
  </section>

  <!-- Selected cases — grid + staggered features -->
  <section class="cases-more container">
    <div class="grid">
      <div class="card card-1" data-reveal>
        <a class="tile" href="/cases/blockchain-products/#custodial-keeper" aria-hidden="true" tabindex="-1"><Pic src="/images/case-custodial-keeper.png" alt="Custodial Keeper interface" /></a>
        <article class="case-intro">
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;25</p>
          <h3 class="t-h4"><a href="/cases/blockchain-products/#custodial-keeper">Custodial Keeper</a></h3>
          <p class="t-body">
            White-label crypto payment integration for Web 2.0 services that can be quickly customized
            to meet the needs of different businesses.
          </p>
        </article>
      </div>
      <div class="card card-2" data-reveal>
        <a class="tile" href="/cases/blockchain-products/#linear-marketplace" aria-hidden="true" tabindex="-1"><Pic src="/images/case-linear-marketplace.png" alt="Linear Marketplace interface" /></a>
        <article class="case-intro">
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;25</p>
          <h3 class="t-h4"><a href="/cases/blockchain-products/#linear-marketplace">Linear Marketplace</a></h3>
          <p class="t-body">A crypto marketplace for trading NFTs and tokens, with automated asset import.</p>
        </article>
      </div>
      <div class="card card-3" data-reveal>
        <a class="tile" href="/cases/blockchain-products/#unwind-x" aria-hidden="true" tabindex="-1"><Pic src="/images/case-unwind.png" alt="Unwind X interface" /></a>
        <article class="case-intro">
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;25</p>
          <h3 class="t-h4"><a href="/cases/blockchain-products/#unwind-x">Unwind X</a></h3>
          <p class="t-body">
            A blockchain platform for buying and trading shares in insurance contracts, designed to make
            complex insurance data easier to understand.
          </p>
        </article>
      </div>
    </div>
    <div class="grid stagger">
      <div class="feature-cognitive">
        <a class="tile tile-cognitive" href="/cases/cognitive-structuring/" data-reveal aria-hidden="true" tabindex="-1">
          <Pic src="/images/case-cognitive.png" alt="Cognitive Structuring interface" />
        </a>
        <article class="case-intro" data-reveal>
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;24</p>
          <h3 class="t-h3"><a href="/cases/cognitive-structuring/">Cognitive <br /><em class="t-h3-serif">Structuring</em></a></h3>
          <p class="t-body">
            An AI-powered QA platform that helps teams create test cases, build testing scenarios, and
            automate project setup. It integrates with the client&rsquo;s broader digital transformation
            ecosystem and makes automated testing easier to manage.
          </p>
        </article>
      </div>
      <div class="feature-ai">
        <a class="tile tile-ai-test" href="/cases/ai-test-optimizer/" data-reveal aria-hidden="true" tabindex="-1">
          <Pic src="/images/case-ai-test.png" alt="AI Test Optimizer interface" />
        </a>
        <article class="case-intro" data-reveal>
          <p class="case-meta t-subtitle">Product Design &amp; Art Direction <i></i> &rsquo;24</p>
          <h3 class="t-h3"><a href="/cases/ai-test-optimizer/">AI Test <br /><em class="t-h3-serif">Optimizer</em></a></h3>
          <p class="t-body">
            A strategic M&amp;A planning tool that helps teams compare merger scenarios, structure
            integration strategies, and generate client-ready reports. It connects with the client&rsquo;s
            global M&amp;A platform and supports taxonomy-driven decision-making.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Work experience -->
  <section class="experience container">
    <SectionTitle title="Work Experience" />
    <div class="cv">
      <div class="cv-row grid" data-reveal>
        <h3 class="t-h4">UX Engineer, Lahzo</h3>
        <p class="t-subtitle">2025 &ndash; 2026</p>
        <p class="t-body">
          Drove product and design direction across AI-agent experiences, internal tools, design
          systems, and brand. Rebuilt the core product to increase conversion by up to 24% and support
          7 new long-term automotive partnerships, while establishing scalable UX frameworks, research
          processes, and automated workflows.
        </p>
      </div>
      <div class="cv-row grid" data-reveal>
        <h3 class="t-h4">Art Director, Trinetix</h3>
        <p class="t-subtitle">2023 &ndash; 2025</p>
        <p class="t-body">
          Oversaw a 20+ person design department, ensuring design quality across 15+ active products
          while improving team processes, evaluation, and growth frameworks. Built scalable management
          systems, recruited and onboarded new talent, and partnered with clients and C-level
          stakeholders on complex strategic design challenges.
        </p>
      </div>
      <div class="cv-row grid" data-reveal>
        <h3 class="t-h4">Principal Designer, Dexola</h3>
        <p class="t-subtitle">2022 &ndash; 2023</p>
        <p class="t-body">
          Shaped blockchain products and art direction across wallets, swaps, staking, and other crypto
          services while leading small design teams. Also drove pre-sales, workshops, and pitch work,
          and created a UX audit framework tailored specifically to blockchain.
        </p>
      </div>
      <div class="cv-row grid" data-reveal>
        <h3 class="t-h4">Lead Product Designer, Trinetix</h3>
        <p class="t-subtitle">2021 &ndash; 2022</p>
        <p class="t-body">
          Managed a team of 2&ndash;4 designers across multiple projects, priorities, and roadmaps.
          Drove stakeholder collaboration, workshops, and design proposals, while reviewing work and
          supporting the team on complex design challenges.
        </p>
      </div>
      <div class="cv-row grid" data-reveal>
        <h3 class="t-h4">Product Designer, Trinetix</h3>
        <p class="t-subtitle">2017 &ndash; 2021</p>
        <p class="t-body">
          Worked across 2&ndash;3 products as part of a small design team, collaborating closely with
          cross-functional partners. Created user flows, wireframes, UI, and interactive prototypes,
          while also running research and testing and building UI kits and visual assets.
        </p>
      </div>
      <div class="cv-row grid" data-reveal>
        <h3 class="t-h4">Product Designer, Untime Studio</h3>
        <p class="t-subtitle">2016 &ndash; 2017</p>
        <p class="t-body">Worked on various e-commerce and mobile projects.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Case tiles: fluid width from the grid, shape kept via aspect-ratio.
     Images crop from the bottom (object-position: top), as in the design. */
  .tile {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .tile img {
    object-fit: cover;
    object-position: top;
    /* Grows from the edge the tile aligns it to, so that edge stays pinned. */
    transform-origin: 50% 100%;
    transition: transform var(--image-hover-duration) var(--image-hover-ease);
  }

  /* Only where a pointer can really hover. Left unguarded, the first tap on a
     touch screen applies :hover instead of following the link. */
  @media (hover: hover) {
    .tile:hover img {
      transform: scale(var(--image-hover-scale));
    }
  }

  .tile-climate img,
  .tile-cognitive img {
    transform-origin: 50% 50%;
  }

  .tile-ai-test img {
    transform-origin: 50% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile img {
      transition: none;
    }

    .tile:hover img {
      transform: none;
    }
  }

  .case-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .case-meta i {
    width: 4px;
    height: 4px;
    background: var(--color-ink);
  }

  .case-intro h3 {
    margin-top: 16px;
  }

  .case-intro h3 + p {
    margin-top: 16px;
  }

  /* ---- Hero ---- */

  .hero {
    position: relative;
    height: 692px;
    align-items: start;
  }

  .hero-aside {
    grid-column: 1 / 4;
    margin-top: 124px;
    color: var(--color-ink-soft);
    /* Arrives in step with the statement — the same delay as .hero-statement
       below — but eases in over a longer, softer beat. */
    --reveal-delay: calc(var(--reveal-stagger) * 2);
    --reveal-duration: 0.55s;
  }

  .roles {
    margin-top: 18px;
    width: 214px;
  }

  .location {
    margin-top: 101px;
  }

  .hero-main {
    grid-column: 4 / 12;
    position: relative;
    margin-top: 124px;
    color: var(--color-ink-soft);
    /* The hero type tracks the window instead of sitting at one size: 64px on
       the 1440 frame and scaling with the column either way. Everything the
       composition is built from is a multiple of this, so the portrait, the
       rule and the sign-off keep their proportions rather than colliding. */
    --hero-size: clamp(45px, 4.444vw, 80px);
  }

  .hero-portrait {
    position: absolute;
    top: -52px;
    left: 0;
    border-radius: 100px 100px 8px 8px;
    object-fit: cover;
  }

  .pointer {
    height: 1px;
    background: var(--color-ink-soft);
  }

  .pointer-intro {
    position: absolute;
    top: calc(0.594 * var(--hero-size));
    /* portrait (73px) + 44px */
    left: 117px;
    width: calc(1.516 * var(--hero-size));
  }

  .hero-headline,
  .hero-statement {
    font-size: var(--hero-size);
    line-height: 1.016;
  }

  /* The first line clears what sits in its indent: the portrait and its 44px
     gap are fixed, the rule and the 16px after it follow the type. */
  .hero-headline {
    text-indent: calc(133px + 1.516 * var(--hero-size));
  }

  .amp {
    font: italic 700 var(--hero-size) / 1.016 var(--font-amp);
    color: var(--color-ink);
  }

  .hero-statement {
    margin-top: 44px;
  }

  /* Hero intro order: portrait first, then the headline, then the statement. */
  .hero-headline,
  .pointer-intro {
    --reveal-delay: var(--reveal-stagger);
  }

  .hero-statement {
    --reveal-delay: calc(var(--reveal-stagger) * 2);
  }

  /* Last line of the statement: the closing words, the rule, and the serif
     sign-off share one line, with the rule stretching to fill what is left. */
  .crafted {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
  }

  .crafted .pointer {
    flex: 1;
    /* Stops the rule being squeezed out of existence on a tight line. */
    min-width: 1em;
    margin: 0 var(--rule-gap) 0 6px;
    transform: translateY(calc(-0.203 * var(--hero-size)));
  }

  /* ---- Featured cases ---- */

  .cases-featured {
    padding-top: 32px;
    padding-bottom: 30px;
  }

  .feature-left {
    grid-column: 1 / 7;
    margin-top: 64px;
  }

  .tile-climate {
    aspect-ratio: 682 / 490;
    background: var(--color-accent-purple);
    align-items: center;
  }

  .tile-climate img {
    width: 80.6%;
    aspect-ratio: 550 / 345;
  }

  .feature-right {
    grid-column: 7 / 12;
    margin-top: 96px;
  }

  .intro-wide {
    width: 79.3%;
  }

  /* This tile comes out of Figma whole, accent and all, so the image is the
     tile rather than a mockup placed on one. */
  .tile-hirepeak {
    aspect-ratio: 565 / 331;
    margin-top: 88px;
    background: var(--color-accent-gold);
  }

  .tile-hirepeak img {
    width: 100%;
    height: 100%;
  }

  .tile-hirepeak + .case-intro {
    margin-top: 32px;
  }

  .expertise-label {
    display: block;
    margin-top: 125px;
    margin-left: calc((100% + var(--grid-gap)) / 12);
  }

  .expertise-quote {
    margin-top: 16px;
    text-indent: 117px;
  }

  /* ---- More cases ---- */

  .cases-more {
    padding-bottom: 122px;
  }

  .cases-more > .grid {
    margin-top: 80px;
    align-items: start;
  }

  .card .tile {
    aspect-ratio: 448 / 331;
    background: var(--color-tile);
    padding-inline: 6.7%;
  }

  .card .tile img {
    width: 100%;
    aspect-ratio: 388 / 259;
    border-radius: 4px 4px 0 0;
  }

  .card .case-intro {
    margin-top: 32px;
    width: 73.9%;
  }

  .card-1 {
    grid-column: 1 / 5;
  }

  .card-2 {
    grid-column: 5 / 9;
  }

  .card-3 {
    grid-column: 9 / 13;
  }

  .cases-more > .stagger {
    margin-top: 121px;
  }

  .feature-cognitive {
    grid-column: 2 / 6;
  }

  .tile-cognitive {
    aspect-ratio: 448 / 340;
    background: var(--color-accent-green);
    align-items: center;
  }

  .tile-cognitive img {
    width: 78.6%;
    aspect-ratio: 352 / 200;
  }

  .feature-cognitive .case-intro {
    margin-top: 32px;
    width: 74.1%;
  }

  .feature-ai {
    grid-column: 6 / 13;
    margin-top: 80px;
  }

  .tile-ai-test {
    aspect-ratio: 798 / 550;
    background: var(--color-accent-blue);
    padding: 8% 11.9% 0;
    align-items: flex-start;
  }

  .tile-ai-test img {
    width: 100%;
    aspect-ratio: 608 / 486;
  }

  .feature-ai .case-intro {
    margin-top: 32px;
    width: 56.1%;
  }

  /* ---- Work experience ---- */

  .experience {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .cv {
    margin-top: 80px;
  }

  .cv-row {
    min-height: 155px;
    align-items: start;
  }

  .cv-row h3 {
    grid-column: 2 / 6;
  }

  .cv-row .t-subtitle {
    grid-column: 6 / 7;
    margin-top: 12px;
    white-space: nowrap;
  }

  .cv-row .t-body {
    grid-column: 7 / 12;
    margin-top: 12px;
  }
</style>

<style>
  /* ---- Tablet ---- */
  @media (max-width: 1180px) {
    .hero {
      height: auto;
      padding-block: 64px;
    }

    .hero-aside,
    .hero-main,
    .feature-left,
    .feature-right,
    .expertise-quote,
    .feature-cognitive,
    .feature-ai {
      grid-column: 1 / -1;
    }

    /* The first column — the initials, the role list and the location — is
       dropped here. Everything else carries over from desktop unchanged and
       simply runs larger, since it now has the full width to itself. */
    .hero-aside {
      display: none;
    }

    .hero-main {
      margin-top: 48px;
      padding-top: 0;
      --hero-size: clamp(48px, 6.25vw, 64px);
    }

    .feature-left {
      margin-top: 48px;
    }

    .feature-right {
      margin-top: 32px;
    }

    .intro-wide {
      width: 100%;
    }

    .tile-hirepeak {
      margin-top: 96px;
    }

    .card-1,
    .card-2 {
      grid-column: span 3;
    }

    /* Once the grid halves, every case closes the same way: 96 between one
       case's description and the next case's photo. */
    .card-3 {
      grid-column: span 3;
      margin-top: 96px;
    }

    .cases-featured,
    .cases-more,
    .experience {
      height: auto;
      min-height: 0;
      padding-bottom: 64px;
    }

    .cases-more > .stagger {
      margin-top: 96px;
    }

    .feature-ai {
      margin-top: 96px;
    }

    .feature-cognitive .case-intro,
    .feature-ai .case-intro,
    .card .case-intro {
      width: 100%;
    }

    .expertise-label {
      margin-top: 115px;
      margin-left: 0;
    }

    .expertise-quote {
      text-indent: 0;
    }

    .cv-row {
      min-height: 0;
      padding-block: 24px;
    }

    .cv-row h3 {
      grid-column: 1 / -1;
    }

    .cv-row .t-subtitle {
      grid-column: 1 / -1;
      margin-top: 8px;
    }

    .cv-row .t-body {
      grid-column: 1 / -1;
      margin-top: 16px;
    }
  }

  /* ---- Mobile ----
     Matches the mobile frame: one column, and the hero drops to 56px. */
  @media (max-width: 767px) {
    .hero {
      padding-block: 40px 56px;
    }

    /* Rebuilt from the mobile frame: the portrait leads, the headline runs the
       full width with no indent, and the statement and the sign-off stack
       beneath it at their own sizes. Neither rule is part of this frame — on a
       phone there is no room for one to read as anything but a stray line. */
    /* The section already opens 40px under the header; the column adds none. */
    .hero-main {
      margin-top: 0;
      padding-top: 0;
      --hero-size: clamp(44px, 9.8vw, 48px);
    }

    .hero-portrait {
      position: static;
      margin-bottom: 16px;
    }

    .pointer-intro,
    .crafted .pointer {
      display: none;
    }

    .hero-headline {
      text-indent: 0;
      line-height: 1.042;
    }

    .hero-statement {
      margin-top: 32px;
      font-size: clamp(29px, 6.53vw, 32px);
      line-height: 1.094;
    }

    /* The sign-off drops onto its own line at the statement's size. */
    .crafted {
      display: contents;
      white-space: normal;
    }

    .crafted em {
      display: block;
      margin-top: 32px;
      font-size: inherit;
      line-height: 1.5625;
    }


    .card-1,
    .card-2,
    .card-3 {
      grid-column: 1 / -1;
    }

    .card-2,
    .card-3 {
      margin-top: 72px;
    }

    .tile-ai-test {
      padding: 8% 6% 0;
    }

    .tile-ai-test img {
      height: auto;
    }

    .expertise-label {
      margin-top: 64px;
    }

    .cases-featured,
    .cases-more,
    .experience {
      padding-bottom: 40px;
    }

    .cv {
      margin-top: 40px;
    }
  }

  /* ---- Tablet hero ----
     Follows the tablet mockup: portrait and rule leading a 64px headline,
     with the sign-off set in from the left. */
  @media (min-width: 768px) and (max-width: 1180px) {
    .hero {
      padding-block: 0 128px;
    }

    .hero-aside {
      display: none;
    }

    .hero-main {
      margin-top: 0;
      padding-top: 110px;
    }

    .hero-portrait,
    .pointer-intro {
      display: block;
    }

    .hero-portrait {
      top: 56px;
      left: 0;
    }

    .pointer-intro {
      top: 146px;
      left: 117px;
      width: 97px;
    }

    /* First line clears the portrait and rule beside it */
    .hero-headline {
      text-indent: 230px;
    }

    .hero-statement {
      margin-top: 32px;
    }

  }
</style>