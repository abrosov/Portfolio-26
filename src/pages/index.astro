---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<BaseLayout title="Alex Abrosov — Design Engineer">
  <!-- Hero -->
  <section class="hero container grid" id="about">
    <div class="hero-aside">
      <p class="t-h2">AA</p>
      <p class="t-subtitle roles">
        / Design Engineering<br />
        / Art Direction<br />
        / Product Management
      </p>
      <p class="t-subtitle location">/ Barcelona, Spain</p>
    </div>
    <img class="hero-portrait" src="/images/hero-portrait.png" alt="Portrait of Alex Abrosov" width="73" height="109" />
    <i class="pointer pointer-intro" aria-hidden="true"></i>
    <h1 class="hero-headline t-h2">
      Design Engineer<br />
      with a decade of experience in Interface Design <em class="amp">&amp;</em> Art Direction.
    </h1>
    <p class="hero-statement t-h2">I set a strong product vision that scales, builds trust, and increases conversion.</p>
    <i class="pointer pointer-crafted" aria-hidden="true"></i>
    <p class="hero-crafted t-h3-serif">All crafted with love.</p>
  </section>

  <!-- Selected cases — featured -->
  <section class="cases-featured container" id="cases">
    <SectionTitle title="Selected Cases" />
    <div class="grid collage">
      <div class="tile tile-climate">
        <img src="/images/case-climate-tech.png" alt="Climate Tech Viewer interface" />
      </div>
      <article class="case-intro intro-climate">
        <p class="case-meta t-subtitle">Product Design &amp; Art Direction <i></i> &rsquo;26</p>
        <h3 class="t-h3">Climate Tech <br /><em class="t-h3-serif">Viewer</em></h3>
        <p class="t-body">
          A platform that helps businesses explore<br />
          and evaluate technologies for reducing greenhouse<br />
          gas emissions across fast-growing industries.
        </p>
      </article>
      <div class="tile tile-portal">
        <img src="/images/case-client-portal.png" alt="Client Portal dashboard" />
      </div>
      <article class="case-intro intro-portal">
        <p class="case-meta t-subtitle">Product Design &amp; Engineering <i></i> &rsquo;26</p>
        <h3 class="t-h3">Client <em class="t-h3-serif">Portal</em></h3>
        <p class="t-body">
          A platform that helps agricultural organizations track, manage, and evaluate the performance
          of AI agents across their customer-facing products.
        </p>
      </article>
    </div>
    <p class="expertise-label t-subtitle">Expertise &amp; key value</p>
    <p class="expertise-quote t-quote">
      Transforming complex ideas into thoughtful product experiences that solve real problems and
      drive the business forward.
    </p>
  </section>

  <!-- Selected cases — grid + staggered features -->
  <section class="cases-more container">
    <div class="grid collage">
      <div class="card card-1">
        <div class="tile"><img src="/images/case-custodial-keeper.png" alt="Custodial Keeper interface" /></div>
        <article class="case-intro">
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;25</p>
          <h3 class="t-h4">Custodial Keeper</h3>
          <p class="t-body">
            White-label crypto payment integration for Web 2.0 services that can be quickly customized
            to meet the needs of different businesses.
          </p>
        </article>
      </div>
      <div class="card card-2">
        <div class="tile"><img src="/images/case-linear-marketplace.png" alt="Linear Marketplace interface" /></div>
        <article class="case-intro">
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;25</p>
          <h3 class="t-h4">Linear Marketplace</h3>
          <p class="t-body">A crypto marketplace for trading NFTs and tokens, with automated asset import.</p>
        </article>
      </div>
      <div class="card card-3">
        <div class="tile"><img src="/images/case-unwind.png" alt="Unwind X interface" /></div>
        <article class="case-intro">
          <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;25</p>
          <h3 class="t-h4">Unwind X</h3>
          <p class="t-body">
            A blockchain platform for buying and trading shares in insurance contracts, designed to make
            complex insurance data easier to understand.
          </p>
        </article>
      </div>

      <div class="tile tile-cognitive">
        <img src="/images/case-cognitive.png" alt="Cognitive Structuring interface" />
      </div>
      <article class="case-intro intro-cognitive">
        <p class="case-meta t-subtitle">Product Design <i></i> &rsquo;24</p>
        <h3 class="t-h3">Cognitive <br /><em class="t-h3-serif">Structuring</em></h3>
        <p class="t-body">
          An AI-powered QA platform that helps teams create test cases, build testing scenarios, and
          automate project setup. It integrates with the client&rsquo;s broader digital transformation
          ecosystem and makes automated testing easier to manage.
        </p>
      </article>
      <div class="tile tile-ai-test">
        <img src="/images/case-ai-test.png" alt="AI Test Optimizer interface" />
      </div>
      <article class="case-intro intro-ai-test">
        <p class="case-meta t-subtitle">Product Design &amp; Art Direction <i></i> &rsquo;24</p>
        <h3 class="t-h3">AI Test <br /><em class="t-h3-serif">Optimizer</em></h3>
        <p class="t-body">
          A strategic M&amp;A planning tool that helps teams compare merger scenarios, structure
          integration strategies, and generate client-ready reports. It connects with the client&rsquo;s
          global M&amp;A platform and supports taxonomy-driven decision-making.
        </p>
      </article>
    </div>
  </section>

  <!-- Work experience -->
  <section class="experience container">
    <SectionTitle title="Work Experience" />
    <div class="cv">
      <div class="cv-row grid">
        <h3 class="t-h4">UX Engineer, Lahzo</h3>
        <p class="t-subtitle">2025 &ndash; 2026</p>
        <p class="t-body">
          Drove product and design direction across AI-agent experiences, internal tools, design
          systems, and brand. Rebuilt the core product to increase conversion by up to 24% and support
          7 new long-term automotive partnerships, while establishing scalable UX frameworks, research
          processes, and automated workflows.
        </p>
      </div>
      <div class="cv-row grid">
        <h3 class="t-h4">Art Director, Trinetix</h3>
        <p class="t-subtitle">2023 &ndash; 2025</p>
        <p class="t-body">
          Oversaw a 20+ person design department, ensuring design quality across 15+ active products
          while improving team processes, evaluation, and growth frameworks. Built scalable management
          systems, recruited and onboarded new talent, and partnered with clients and C-level
          stakeholders on complex strategic design challenges.
        </p>
      </div>
      <div class="cv-row grid">
        <h3 class="t-h4">Principal Designer, Dexola</h3>
        <p class="t-subtitle">2022 &ndash; 2023</p>
        <p class="t-body">
          Shaped blockchain products and art direction across wallets, swaps, staking, and other crypto
          services while leading small design teams. Also drove pre-sales, workshops, and pitch work,
          and created a UX audit framework tailored specifically to blockchain.
        </p>
      </div>
      <div class="cv-row grid">
        <h3 class="t-h4">Lead Product Designer, Trinetix</h3>
        <p class="t-subtitle">2021 &ndash; 2022</p>
        <p class="t-body">
          Managed a team of 2&ndash;4 designers across multiple projects, priorities, and roadmaps.
          Drove stakeholder collaboration, workshops, and design proposals, while reviewing work and
          supporting the team on complex design challenges.
        </p>
      </div>
      <div class="cv-row grid">
        <h3 class="t-h4">Product Designer, Trinetix</h3>
        <p class="t-subtitle">2017 &ndash; 2021</p>
        <p class="t-body">
          Worked across 2&ndash;3 products as part of a small design team, collaborating closely with
          cross-functional partners. Created user flows, wireframes, UI, and interactive prototypes,
          while also running research and testing and building UI kits and visual assets.
        </p>
      </div>
      <div class="cv-row grid">
        <h3 class="t-h4">Product Designer, Untime Studio</h3>
        <p class="t-subtitle">2016 &ndash; 2017</p>
        <p class="t-body">Worked on various e-commerce and mobile projects.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Children of a collage grid share row 1 and are offset with margins,
     reproducing the staggered Figma layout while staying fluid. */
  .collage {
    position: relative;
    align-items: start;
  }

  .collage > * {
    grid-row: 1;
  }

  .tile {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .case-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .case-meta i {
    width: 4px;
    height: 4px;
    background: var(--color-ink);
  }

  .case-intro h3 {
    margin-top: 16px;
  }

  .case-intro h3 + p {
    margin-top: 16px;
  }

  /* ---- Hero ---- */

  .hero {
    position: relative;
    height: 692px;
    align-items: start;
  }

  .hero > * {
    grid-row: 1;
  }

  .hero-aside {
    grid-column: 1 / 4;
    margin-top: 124px;
  }

  .hero-aside > .t-h2 {
    color: var(--color-ink-soft);
  }

  .roles {
    margin-top: 18px;
    width: 214px;
  }

  .location {
    margin-top: 101px;
  }

  .hero-portrait {
    grid-column: 4 / 5;
    margin-top: 72px;
    border-radius: 100px 100px 8px 8px;
    object-fit: cover;
  }

  .pointer {
    height: 1px;
    background: var(--color-ink-soft);
  }

  .pointer-intro {
    grid-column: 5 / 6;
    margin-top: 162px;
  }

  .hero-headline {
    grid-column: 4 / 12;
    margin-top: 124px;
    color: var(--color-ink-soft);
    text-indent: 231px;
  }

  .amp {
    font: italic 700 64px/65px var(--font-serif);
    color: var(--color-ink);
  }

  .hero-statement {
    grid-column: 4 / 12;
    margin-top: 363px;
    color: var(--color-ink-soft);
  }

  .pointer-crafted {
    grid-column: 7 / 9;
    margin-top: 533px;
  }

  .hero-crafted {
    grid-column: 9 / 12;
    margin-top: 505px;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  /* ---- Featured cases ---- */

  .cases-featured {
    padding-top: 32px;
    height: 1290px;
  }

  .cases-featured .collage {
    margin-top: 0;
  }

  .tile-climate {
    grid-column: 1 / 7;
    margin-top: 64px;
    height: 490px;
    background: var(--color-accent-purple);
    align-items: center;
  }

  .tile-climate img {
    width: 80.6%;
  }

  .intro-climate {
    grid-column: 7 / 11;
    margin-top: 96px;
  }

  .tile-portal {
    grid-column: 7 / 12;
    margin-top: 398px;
    height: 331px;
    background: var(--color-accent-gold);
  }

  .tile-portal img {
    width: 73.1%;
    border-radius: 4px 4px 0 0;
  }

  .intro-portal {
    grid-column: 7 / 11;
    margin-top: 761px;
  }

  .expertise-label {
    display: block;
    margin-top: 126px;
    margin-left: calc((100% + var(--grid-gap)) / 12);
  }

  .expertise-quote {
    margin-top: 16px;
    text-indent: 117px;
  }

  /* ---- More cases ---- */

  .cases-more {
    height: 1751px;
  }

  .card .tile {
    height: 331px;
    background: var(--color-tile);
    padding-inline: 30px;
  }

  .card .tile img {
    width: 100%;
    border-radius: 4px 4px 0 0;
  }

  .card .case-intro {
    margin-top: 32px;
    width: 331px;
  }

  .card-1 {
    grid-column: 1 / 5;
    margin-top: 80px;
  }

  .card-2 {
    grid-column: 5 / 9;
    margin-top: 80px;
  }

  .card-3 {
    grid-column: 9 / 13;
    margin-top: 80px;
  }

  .tile-cognitive {
    grid-column: 2 / 6;
    margin-top: 732px;
    height: 340px;
    background: var(--color-accent-green);
    align-items: center;
  }

  .tile-cognitive img {
    width: 78.6%;
  }

  .intro-cognitive {
    grid-column: 2 / 5;
    margin-top: 1104px;
  }

  .tile-ai-test {
    grid-column: 6 / 13;
    margin-top: 812px;
    height: 550px;
    background: var(--color-accent-blue);
    padding: 64px 95px 0;
  }

  .tile-ai-test img {
    width: 100%;
    height: 486px;
    object-fit: cover;
    object-position: top;
  }

  .intro-ai-test {
    grid-column: 6 / 10;
    margin-top: 1394px;
  }

  /* ---- Work experience ---- */

  .experience {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .cv {
    margin-top: 80px;
  }

  .cv-row {
    min-height: 155px;
    align-items: start;
  }

  .cv-row h3 {
    grid-column: 2 / 6;
  }

  .cv-row .t-subtitle {
    grid-column: 6 / 7;
    margin-top: 12px;
    white-space: nowrap;
  }

  .cv-row .t-body {
    grid-column: 7 / 12;
    margin-top: 12px;
  }
</style>
